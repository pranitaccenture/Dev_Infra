# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files, as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore tfplan files
*tfplan*

# OS specific files
.DS_Store
Thumbs.db

# Log files
*.log

# SSH keys (never commit!)
*.pem
*.pub
*.key

# Sensitive files
.env
.env.local
*.secret
